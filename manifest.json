{
  "manifest_version": 3,
  "name": "AI Study Companion",
  "version": "1.0",
  "description": "An AI-powered Chrome extension to summarize, explain, and quiz highlighted text.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
